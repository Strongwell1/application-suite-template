{
  "name": "skeleton-spa-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "vite --mode development",
    "start:development": "vite --mode development",
    "start:dev": "vite --mode dev",
    "start:uat": "vite --mode uat",
    "start:prod": "vite --mode prod",
    "build": "vite build --mode prod && tsc -b",
    "build:dev": "vite build --mode dev && tsc -b",
    "build:uat": "vite build --mode uat && tsc -b",
    "build:prod": "vite build --mode prod && tsc -b",
    "lint": "eslint .",
    "preview": "vite preview",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "test": "vitest",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@azure/msal-browser": "^4.30.0",
    "@tanstack/react-form": "^1.29.1",
    "@tanstack/react-query": "^5.100.9",
    "@tanstack/react-router": "^1.169.2",
    "bootstrap": "^5.3.8",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tanstack/react-query-devtools": "^5.100.9",
    "@tanstack/router-devtools": "^1.166.13",
    "@tanstack/router-plugin": "^1.167.34",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/ui": "^4.1.8",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "vitest": "^4.1.8"
  }
}
