{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=Skeleton;Integrated Security=true;TrustServerCertificate=True;"
  },
  "Authentication": {
    "Audience": "your-audience-client-id-here",
    "Authority": "https://login.microsoftonline.com/your-tenant-id-here/v2.0"
  },
  "Cors": {
    "AllowedOrigins": {
      "ClientApp": "http://localhost:5173"
    }
  },
  "AzureStorage": {
    "AccountUrl": "https://your-storage-account-here.blob.core.windows.net/",
    "ContainerName": "attachments",
    "TenantId": "your-tenant-id-here"
  },
  "Email": {
    "FromAddress": "DoNotReply@your-domain-here.com",
    "ConnectionString": "endpoint=https://your-acs-resource.communication.azure.com/;accesskey=your-access-key-here",
    "OverrideToAddress": "developer@your-domain-here.com"
  },
  "App": {
    "SpaBaseUrl": "http://localhost:5173"
  }
}
